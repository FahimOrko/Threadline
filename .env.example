# Server-only. Never prefix with NEXT_PUBLIC_. Real values go in .env.local and Vercel.
OPENROUTER_API_KEY=
# Comma-separated priority list of free models (all must end in :free)
OPENROUTER_MODELS=
# Max tool-call steps per AI request (protects the 20 requests/minute free limit)
AI_MAX_TOOL_STEPS=3
